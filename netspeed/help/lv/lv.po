#. (itstool) path: sect1/para
#: C/index.docbook:351
msgid ""
"This dialog shows you some useful information on the configuration of your "
"network device."
msgstr ""
"Šajā dialoglodziņā redzama noderīga informācija par jūsu tīkla ierīces "
"konfigurāciju."

#. (itstool) path: listitem/para
#: C/index.docbook:356
msgid ""
"<guilabel>Internet Address:</guilabel> The IP (Internet Protocol) address of"
" the network device."
msgstr ""
"<guilabel>Interneta adrese:</guilabel> tīkla ierīces IP (interneta "
"protokola) adrese."

#. (itstool) path: listitem/para
#: C/index.docbook:359
msgid ""
"<guilabel>Netmask:</guilabel> The netmask which depends on the size of your "
"LAN (Local Area Network). A usual value is 255.255.255.0 (a class C "
"network)."
msgstr ""
"<guilabel>Tīkla maska:</guilabel> tīkla maska, kas atkarīga no jūsu LAN "
"(lokālā tīkla) lieluma. Parasti tā ir 255.255.255.0 (C klases tīkls)."

#. (itstool) path: listitem/para
#: C/index.docbook:363
msgid ""
"<guilabel>Hardware Address:</guilabel> Often also referred to as the "
"physical or MAC (Media Access Control) address. A worldwide unique "
"identifier for your network card."
msgstr ""
"<guilabel>Aparatūras adrese:</guilabel> bieži saukta arī par fizisko jeb MAC "
"(Media Access Control) adresi. Jūsu tīkla kartes visā pasaulē unikāls "
"identifikators."

#. (itstool) path: listitem/para
#: C/index.docbook:367
msgid ""
"<guilabel>P-t-P Address:</guilabel> The internet address of the \"other "
"side\" of your PPP (Point to Point Protocol) connection."
msgstr ""
"<guilabel>P-t-P adrese:</guilabel> jūsu PPP (Point to Point Protocol) "
"savienojuma „otras puses” interneta adrese."

#. (itstool) path: listitem/para
#: C/index.docbook:371
msgid ""
"<guilabel>Bytes in:</guilabel> The amount of bytes that the network device "
"has received since it has been connected to the network."
msgstr ""
"<guilabel>Ienākošie baiti:</guilabel> baitu skaits, ko tīkla ierīce ir "
"saņēmusi kopš pievienošanas tīklam."

#. (itstool) path: listitem/para
#: C/index.docbook:375
msgid ""
"<guilabel>Bytes out:</guilabel> The amount of bytes that the network device "
"has sent since it has been connected to the network."
msgstr ""
"<guilabel>Izejošie baiti:</guilabel> baitu skaits, ko tīkla ierīce ir "
"nosūtījusi kopš pievienošanas tīklam."

