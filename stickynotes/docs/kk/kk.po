"Scroll down the list of items in the <guilabel>Add to Panel</guilabel> "
"dialog, then select <guilabel>Sticky Notes</guilabel>."
msgstr ""
"<guilabel>Панельге қосу</guilabel> сұхбат терезесіндегі элементтер тізімін "
"төмен айналдырып, <guilabel>Жабысқақ ескертпелерді</guilabel> таңдаңыз."

#. (itstool) path: listitem/para
#: C/index.docbook:245
msgid "Click <guibutton>Add</guibutton>."
msgstr "<guibutton>Қосу</guibutton> батырмасын шертіңіз."

#. (itstool) path: sect2/para
#: C/index.docbook:250
